# Copy to .env to override. Every value is optional; the defaults shown are
# development-only. Never commit .env and never reuse these outside local dev.

# --- PostgreSQL (used by the postgres container and the app containers) ---
POSTGRES_DB=jobqueue
POSTGRES_USER=jobqueue
POSTGRES_PASSWORD=jobqueue

# --- Host ports (change if something local already uses them) ---
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8080

# --- Worker pool (applies to each `worker` container) ---
# Threads per container; total parallelism = replicas x this value.
JOBQUEUE_WORKER_CONCURRENCY=4
